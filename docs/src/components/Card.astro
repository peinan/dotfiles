---
import UICard from './ui/card.astro';

interface Props {
  title: string;
  description?: string;
  href?: string;
}

const { title, description, href } = Astro.props;
---

{href ? (
  <a href={href} class="block">
    <UICard class="p-6 hover:bg-muted transition-all duration-200 cursor-pointer">
      <h3 class="text-lg font-semibold text-card-foreground mb-2">{title}</h3>
      {description && <p class="text-muted-foreground text-sm">{description}</p>}
    </UICard>
  </a>
) : (
  <UICard class="p-6">
    <h3 class="text-lg font-semibold text-card-foreground mb-2">{title}</h3>
    {description && <p class="text-muted-foreground text-sm">{description}</p>}
  </UICard>
)}

