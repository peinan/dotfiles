---
import { cn } from '../lib/utils';
import { FolderGit2, Home, Download, Settings, Layers } from 'lucide-astro';

const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/dotfiles/', label: 'Home', icon: Home },
  { href: '/dotfiles/install', label: 'Install', icon: Download },
  { href: '/dotfiles/config', label: 'Config', icon: Settings },
  { href: '/dotfiles/submodules', label: 'Submodules', icon: Layers },
];
---

<header class="border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 sticky top-0 z-50">
  <nav class="container flex h-16 items-center">
    <a href="/dotfiles/" class="mr-6 flex items-center space-x-2">
      <FolderGit2 class="h-5 w-5" />
      <span class="text-xl font-semibold text-foreground">dotfiles</span>
    </a>
    <ul class="flex flex-1 items-center justify-end space-x-1">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || currentPath.startsWith(item.href + '/');
        return (
          <li>
            <a
              href={item.href}
              class={cn(
                'inline-flex items-center justify-center rounded-md px-3 py-2 text-sm font-medium transition-colors',
                'hover:bg-accent hover:text-accent-foreground',
                'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring',
                isActive
                  ? 'bg-accent text-accent-foreground'
                  : 'text-muted-foreground'
              )}
            >
              <item.icon class="mr-2 h-4 w-4" />
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

