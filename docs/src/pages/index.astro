---
import PageLayout from '../layouts/PageLayout.astro';
import Card from '../components/Card.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Button from '../components/ui/button.astro';
import { Download, Github, Terminal, Code, GitBranch, Rocket, Package } from 'lucide-astro';
import { cn } from '../lib/utils';
---

<PageLayout title="peinan's dotfiles" description="Configuration files for OS, shell, Neovim, tmux and others">
  <div class="container py-12">
    <!-- Hero Section -->
    <section class="text-center mb-16">
      <h1 class="text-4xl sm:text-5xl font-bold text-foreground mb-4">
        peinan's dotfiles
      </h1>
      <p class="text-xl text-muted-foreground max-w-2xl mx-auto mb-8">
        A collection of configuration files and scripts for OS, shell, Neovim, tmux, and more
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/dotfiles/install" variant="outline" size="lg">
          <Download class="mr-2 h-4 w-4" />
          View Installation Guide
        </Button>
        <Button href="https://github.com/peinan/dotfiles" variant="outline" size="lg" target="_blank" rel="noopener noreferrer">
          <Github class="mr-2 h-4 w-4" />
          View on GitHub
        </Button>
      </div>
    </section>

    <!-- Quick Start -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold text-foreground mb-6">Quick Start</h2>
      <CodeBlock code={`# Clone the repository
git clone https://github.com/peinan/dotfiles.git ~/.dotfiles

# Navigate to the directory
cd ~/.dotfiles

# Initialize submodules
git submodule update --init --recursive

# Create symbolic links (as needed)
# Example: .zshrc
ln -s ~/.dotfiles/src/.zshrc ~/.zshrc`} language="bash" />
      <p class="text-muted-foreground mt-4">
        For detailed installation instructions, see the <a href="/dotfiles/install" class="text-primary hover:text-primary/80 font-medium">installation page</a>.
      </p>
    </section>

    <!-- Features -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold text-foreground mb-6">Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <Card
          title="Shell Configuration"
          description="Zsh configuration, aliases, environment variables, and more"
          href="/dotfiles/config#shell"
        />
        <Card
          title="Neovim Configuration"
          description="Neovim settings and plugin management"
          href="/dotfiles/submodules#nvim"
        />
        <Card
          title="tmux Configuration"
          description="tmux settings and key bindings"
          href="/dotfiles/submodules#tmux"
        />
        <Card
          title="Git Configuration"
          description="Git settings and beautiful diff display with delta"
          href="/dotfiles/config#git"
        />
        <Card
          title="Starship"
          description="Fast and customizable prompt"
          href="/dotfiles/config#starship"
        />
        <Card
          title="Homebrew"
          description="Package management with Brewfile"
          href="/dotfiles/config#brewfile"
        />
      </div>
    </section>

    <!-- Repository Info -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold text-foreground mb-6">Repository Structure</h2>
      <div class="bg-card border border-border rounded-lg p-6 shadow-sm">
        <p class="text-card-foreground mb-4">
          This repository contains a collection of configuration files for efficiently setting up a development environment.
          The main configurations include:
        </p>
        <ul class="list-disc list-inside space-y-2 text-card-foreground">
          <li><strong>Shell Configuration</strong>: .zshrc, .zshenv, .alias, and more</li>
          <li><strong>Git Configuration</strong>: .gitconfig with beautiful diff display using delta</li>
          <li><strong>Editor Configuration</strong>: Neovim and Vim settings (submodules)</li>
          <li><strong>Terminal Configuration</strong>: tmux settings (submodule)</li>
          <li><strong>Prompt</strong>: Starship configuration</li>
          <li><strong>Package Management</strong>: Homebrew Brewfile</li>
        </ul>
      </div>
    </section>

  </div>
</PageLayout>

