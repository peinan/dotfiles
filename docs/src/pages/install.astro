---
import PageLayout from '../layouts/PageLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Card from '../components/ui/card.astro';
import { AlertCircle, Info } from 'lucide-astro';
---

<PageLayout title="Installation Guide - peinan's dotfiles" description="Installation and setup instructions for dotfiles">
  <div class="container py-12">
    <h1 class="text-4xl font-bold text-foreground mb-8">Installation Guide</h1>

    <!-- Prerequisites -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold text-foreground mb-4">Prerequisites</h2>
      <Card class="p-6 mb-6">
        <p class="text-card-foreground mb-4">The following tools must be installed:</p>
        <ul class="list-disc list-inside space-y-2 text-card-foreground">
          <li><strong>Git</strong>: Required for cloning the repository</li>
          <li><strong>Homebrew</strong> (macOS): Used for package management</li>
          <li><strong>Zsh</strong>: Required if using shell configuration</li>
        </ul>
      </Card>
    </section>

    <!-- Step 1: Clone Repository -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold text-foreground mb-4">Step 1: Clone Repository</h2>
      <p class="text-muted-foreground mb-4">
        Clone the repository to <code class="bg-muted px-2 py-1 rounded text-foreground">.dotfiles</code> in your home directory.
      </p>
      <CodeBlock code={`# Clone the repository
git clone https://github.com/peinan/dotfiles.git ~/.dotfiles

# Navigate to the directory
cd ~/.dotfiles`} language="bash" />
    </section>

    <!-- Step 2: Initialize Submodules -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold text-foreground mb-4">Step 2: Initialize Submodules</h2>
      <p class="text-muted-foreground mb-4">
        This repository uses the following submodules. All must be initialized:
      </p>
      <ul class="list-disc list-inside space-y-2 text-muted-foreground mb-4">
        <li><code class="bg-muted px-2 py-1 rounded text-foreground">src/.config/tmux</code> - tmux configuration</li>
        <li><code class="bg-muted px-2 py-1 rounded text-foreground">src/.config/nvim</code> - Neovim configuration</li>
        <li><code class="bg-muted px-2 py-1 rounded text-foreground">src/.config/vim</code> - Vim configuration</li>
      </ul>
      <CodeBlock code={`# Initialize all submodules
git submodule update --init --recursive`} language="bash" />
      <p class="text-muted-foreground text-sm mt-4">
        You can also initialize each submodule individually by navigating to each submodule directory.
      </p>
    </section>

    <!-- Step 3: Install Homebrew Packages -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold text-foreground mb-4">Step 3: Install Homebrew Packages</h2>
      <p class="text-muted-foreground mb-4">
        Install required packages in bulk using the Brewfile.
      </p>
      <CodeBlock code={`# Install packages from Brewfile
brew bundle install --file ~/.dotfiles/src/Brewfile`} language="bash" />
      <Card class="p-4 mt-4 bg-primary/10 border-primary/20">
        <div class="flex items-start gap-2">
          <Info class="h-4 w-4 mt-0.5 text-primary flex-shrink-0" />
          <p class="text-sm text-foreground">
            <strong>Note:</strong> This command installs many packages and may take some time.
            To install only specific packages, edit the Brewfile.
          </p>
        </div>
      </Card>
    </section>

    <!-- Step 4: Setup Shell Configuration -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold text-foreground mb-4">Step 4: Setup Shell Configuration</h2>
      <p class="text-muted-foreground mb-4">
        Link Zsh configuration files with symbolic links.
      </p>
      <CodeBlock code={`# Link .zshrc
ln -s ~/.dotfiles/src/.zshrc ~/.zshrc

# Link .zshenv
ln -s ~/.dotfiles/src/.zshenv ~/.zshenv

# Link .alias
ln -s ~/.dotfiles/src/.alias ~/.alias`} language="bash" />
      <Card class="p-4 mt-4 bg-yellow-500/10 border-yellow-500/20">
        <div class="flex items-start gap-2">
          <AlertCircle class="h-4 w-4 mt-0.5 text-yellow-600 dark:text-yellow-400 flex-shrink-0" />
          <p class="text-sm text-yellow-800 dark:text-yellow-300">
            <strong>If existing configuration files exist:</strong> Please backup existing files before creating links.
          </p>
        </div>
      </Card>
    </section>

    <!-- Step 5: Setup Git Configuration -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold text-foreground mb-4">Step 5: Setup Git Configuration</h2>
      <p class="text-muted-foreground mb-4">
        Link the Git configuration file.
      </p>
      <CodeBlock code={`# Link .gitconfig
ln -s ~/.dotfiles/src/.gitconfig ~/.gitconfig`} language="bash" />
      <p class="text-muted-foreground text-sm mt-4">
        <strong>Note:</strong> Please edit <code class="bg-muted px-2 py-1 rounded text-foreground">.gitconfig</code> to change the username and email address as needed.
      </p>
    </section>

    <!-- Step 6: Setup Editor Configurations -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold text-foreground mb-4">Step 6: Setup Editor Configurations</h2>
      <p class="text-muted-foreground mb-4">
        Neovim and Vim configurations are managed as submodules. Link the configuration directories.
      </p>
      <CodeBlock code={`# Link Neovim configuration
ln -s ~/.dotfiles/src/.config/nvim ~/.config/nvim

# Link Vim configuration (if using)
ln -s ~/.dotfiles/src/.config/vim ~/.config/vim`} language="bash" />
    </section>

    <!-- Step 7: Setup Other Configurations -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold text-foreground mb-4">Step 7: Setup Other Configurations</h2>
      <p class="text-muted-foreground mb-4">
        Link other configuration files as needed.
      </p>
      <CodeBlock code={`# Link Starship configuration
mkdir -p ~/.config/starship
ln -s ~/.dotfiles/src/.config/starship/starship.toml ~/.config/starship/starship.toml

# Link Sheldon configuration
mkdir -p ~/.config/sheldon
ln -s ~/.dotfiles/src/.config/sheldon/plugins.toml ~/.config/sheldon/plugins.toml

# Link tmux configuration
ln -s ~/.dotfiles/src/.config/tmux ~/.config/tmux`} language="bash" />
    </section>

    <!-- Step 8: Restart Shell -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold text-foreground mb-4">Step 8: Restart Shell</h2>
      <p class="text-muted-foreground mb-4">
        Start a new shell session to apply the configuration.
      </p>
      <CodeBlock code={`# Reload current shell
source ~/.zshrc

# Or open a new terminal window`} language="bash" />
    </section>

    <!-- Verification -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold text-foreground mb-4">Verification</h2>
      <p class="text-muted-foreground mb-4">
        Verify that the configuration is loaded correctly with the following commands:
      </p>
      <CodeBlock code={`# Check if Starship prompt is displayed
starship --version

# Check if Sheldon plugins are loaded
sheldon lock

# Check if Neovim starts
nvim --version`} language="bash" />
    </section>

    <!-- Troubleshooting -->
    <section>
      <h2 class="text-3xl font-bold text-foreground mb-4">Troubleshooting</h2>
      <Card class="p-6">
        <h3 class="text-xl font-semibold text-card-foreground mb-3">Common Issues</h3>
        <div class="space-y-4">
          <div>
            <h4 class="font-semibold text-card-foreground mb-2">Submodule is empty</h4>
            <p class="text-muted-foreground text-sm mb-2">
              The submodule may not be initialized correctly. Run the following:
            </p>
            <CodeBlock code={`git submodule update --init --recursive`} language="bash" />
          </div>
          <div>
            <h4 class="font-semibold text-card-foreground mb-2">Cannot create symbolic link</h4>
            <p class="text-muted-foreground text-sm mb-2">
              If an existing file exists, backup and remove it first:
            </p>
            <CodeBlock code={`# Example: for .zshrc
mv ~/.zshrc ~/.zshrc.backup
ln -s ~/.dotfiles/src/.zshrc ~/.zshrc`} language="bash" />
          </div>
          <div>
            <h4 class="font-semibold text-card-foreground mb-2">Package installation fails</h4>
            <p class="text-muted-foreground text-sm">
              Homebrew may not be up to date. Run <code class="bg-muted px-2 py-1 rounded text-foreground">brew update</code> and try again.
            </p>
          </div>
        </div>
      </Card>
    </section>
  </div>
</PageLayout>
