# --------------------------------
# Basical MacOS/Linux/Unix aliases
# --------------------------------

## ls
alias ls="ls -GF"
alias la="ls -ahGF"
alias ll="ls -lhGF"
alias lla="ls -alhGF"

## always use Neovim
alias vi="nvim"
alias vin="vim +NERDTree"

## others
alias rm='rm -i'
alias rmt='trash-put'
alias cp='cp -i'
alias mv='mv -i'
alias mkdir='mkdir -p'
alias lv='less -MN'
alias pbc='pbcopy'
alias pbp='pbpaste'
alias vclip='pbpaste | vi -'
alias hist='history'
alias valias='vi ~/.alias*'
alias salias='source ~/.alias*'

# Python
alias py='python'
alias ipy='ipython'
alias pyc='python -c'

# Screen
alias scr='screen -r'
alias scls='screen -ls'
alias scs='screen -S'
alias sc='screen'

# Others
alias rez='source ~/.zshrc'
alias res='exec $SHELL -l'
alias rea='source ~/.alias'
alias zshrc="vi ~/.zshrc"
alias zshenv="vi ~/.zshenv"
alias vstar="vi ~/.config/starship.toml"
alias vimrc="vi ~/.vimrc"
alias vimdein="vin ~/.vim/userautoload/dein'"
alias vimplug="vin ~/.vim/userautoload/plugins'"
alias viminit="vin ~/.vim/userautoload/init'"
## restart wifi
alias rwf='networksetup -setairportpower Wi-Fi off && sleep 1 && networksetup -setairportpower Wi-Fi on'


# -------------------
# Additional Commands
# -------------------

## grep
alias grep="grep --color -n -I --exclude='*.git'"

## tmux
if type tmux > /dev/null 2>&1; then
  alias tm='tmux'
  alias tmls='tmux ls'
  alias tms='tmux new -s'
  alias tm1='tmux new -s session-1'
  alias tm2='tmux new -s session-2'
  alias tma='tmux attach -t'
  alias tmk='tmux kill-session -t'
  alias tmc='tmux save-buffer - | pbcopy'
  alias tmres='tmux respawn-pane -k'
fi
alias tmconf='vi ~/.tmux.conf'

## tree
if type tree > /dev/null 2>&1; then
  alias tree="tree -NC" # N: 文字化け対策, C:色をつける
fi

## nkf
if type nkf > /dev/null 2>&1; then
  alias nkw='nkf -w'
fi

## eza
if type eza > /dev/null 2>&1; then
  alias e="eza"
  alias ea="eza -a"
  alias el="eza -l -hbUm --git"
  alias ela="eza -al -hbUm --git"

  alias ls="e"
  alias la="ea"
  alias ll="el"
  alias lla="ela"
  alias lt="el -T -L2"
  alias lta="el -T"
fi

## pygmentize (less や cat に syntax highlight をつける)
if type pygmentize > /dev/null 2>&1; then
  alias c='pygmentize -O style=monokai -f console256 -g'
fi

## tw -- a CLI twitter client
if type tw > /dev/null 2>&1; then
  alias twd="tw @so1owingpixy/default"
  alias twt="tw @so1owingpixy --timeline"
fi

## NeoVim
if type nvim > /dev/null 2>&1; then
  alias nv="nvim"
fi

## Rust Cargo
if type cargo > /dev/null 2>&1; then
  alias rsc="rustc"
  alias ca="cargo"
  alias cab="cargo build"
  alias car="cargo run"
fi

## kubectl
if type kubectl > /dev/null 2>&1; then
  alias kc="kubectl"
fi

## firebase
if type firebase > /dev/null 2>&1; then
  alias fb="firebase"
fi

## docker
alias docker="/Applications/Docker.app/Contents/Resources/bin/docker"

## cursor
if type cursor > /dev/null 2>&1; then
    alias cs="cursor"
fi

## aicommit2
if type aicommit2 > /dev/null 2>&1; then
    alias aic="aicommit2 -e"
    alias aici="aicommit2 -ei"
fi

## claude
if type claude > /dev/null 2>&1; then
    alias cl="claude"
fi

## zoxide
if type zoxide > /dev/null 2>&1; then
    alias cd="z"
fi

## fzf
if type fzf > /dev/null 2>&1; then
    alias -g F='| fzf'
fi

## open with browser
if type open_with_browser > /dev/null 2>&1; then
    alias chrome="open_with_browser -c"
    alias chr="chrome"
    alias safari="open_with_browser -s"
    alias saf="safari"
fi


# ------------
# Suffix Alias
# ------------

alias -s py='python'
alias -s gz='tar -xzvf'
alias -s html='open'

# --------------
# Path Expansion
# --------------

## Local Directories
if [ -v XDG_CONFIG_HOME ]; then
    hash -d config="$XDG_CONFIG_HOME"
fi
if [ -v XDG_BIN_HOME ]; then
    hash -d bin="$XDG_BIN_HOME"
fi
if [ -v XDG_DATA_HOME ]; then
    hash -d share="$XDG_DATA_HOME"
fi

if type ghq > /dev/null 2>&1; then
    hash -d gh="$(ghq root)/github.com"
fi
hash -d pg="${HOME}/playground"
hash -d pj="${HOME}/Projects"

hash -d doc="${HOME}/Documents"
hash -d down="${HOME}/Downloads"
hash -d desk="${HOME}/Desktop"
hash -d lib="${HOME}/Library"
hash -d pic="${HOME}/Pictures"
hash -d ss="${HOME}/Pictures/ss"

## Cloud Drives
hash -d gd="${HOME}/Google Drive/マイドライブ"
hash -d icloud="${HOME}/Library/Mobile Documents/com~apple~CloudDocs"


# --------------
# Path Expansion
# --------------

alias -g C='| pbcopy'
alias -g H='| head'
alias -g T='| tail'
alias -g L='| less -R'
alias -g DN='/dev/null'
