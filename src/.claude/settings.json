{
  "enabledPlugins": {
    "codex@openai-codex": true,
    "cycloud-plugin@ailab": true,
    "document-skills@anthropic-agent-skills": true,
    "example-skills@anthropic-agent-skills": true,
    "last30days@last30days-skill": true,
    "lua-lsp@claude-plugins-official": true,
    "plan-task-with-coding-guideline@ailab": true,
    "review-plugin@ailab": true,
    "skill-codex@skill-codex": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "upgrading-expo@expo-plugins": true
  },
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "extraKnownMarketplaces": {
    "ailab": {
      "source": {
        "source": "git",
        "url": "https://github.com/CyberAgentAILab/claude-plugins.git"
      }
    },
    "last30days-skill": {
      "source": {
        "repo": "mvanhorn/last30days-skill",
        "source": "github"
      }
    },
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "zsh ~/.claude/scripts/notify.sh",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      },
      {
        "hooks": [
          {
            "command": "zsh ~/.claude/scripts/notify.sh",
            "type": "command"
          }
        ],
        "matcher": "elicitation_dialog"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "async": false,
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "timeout": 300,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "zsh ~/.claude/scripts/notify.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus[1m]",
  "permissions": {
    "allow": [
      "mcp__serena",
      "Read(**/bin/**)",
      "Read(~/ghq/**)",
      "Read(~/.config/**)",
      "Write(**)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(ls*)",
      "Bash(tree*)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(npm *)",
      "Bash(eza*)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(zsh -n *)",
      "Bash(gh *)",
      "Bash(gh issues *)",
      "Bash(sed *)",
      "Bash(xargs *)",
      "Bash(git *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(realpath *)",
      "Bash(pwd*)",
      "Bash(date*)",
      "Bash(uname*)",
      "Bash(whoami)",
      "Bash(hostname*)",
      "Bash(id*)",
      "Bash(sw_vers*)",
      "Bash(type *)",
      "Bash(open *)",
      "Bash(bat *)",
      "Bash(jq *)",
      "Bash(diff *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(df *)",
      "Bash(codex exec *)",
      "Bash(fzf *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:npmjs.org)",
      "WebFetch(domain:note.com)",
      "WebFetch(domain:qiita.com)",
      "WebFetch(domain:zenn.dev)"
    ],
    "ask": [
      "Read(**/*key.*)",
      "Read(**/*_key*)",
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(wget *)",
      "Bash(curl *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(sed -i *)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*token*)",
      "Write(.env)",
      "Write(.env.local)",
      "Write(.env.development)",
      "Write(.env.production)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.development)",
      "Write(**/.env.production)",
      "Write(**/*secret*)",
      "Bash(sudo *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(rm -rf *)"
    ]
  },
  "plansDirectory": "./.claude/plans/",
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "bash ~/.claude/scripts/statusline.sh",
    "type": "command"
  }
}
