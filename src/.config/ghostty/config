config-file = background-control

###
# General
###

clipboard-read = allow
clipboard-write = allow
copy-on-select = false

macos-option-as-alt = true
macos-icon = xray

quick-terminal-position = right
quick-terminal-screen = mouse
quick-terminal-animation-duration = 0.05


###
# Visual
###

# window
fullscreen = false
window-height = 100000
window-width = 100000
window-padding-x = 3
window-padding-y = 3
window-padding-balance = true
window-theme = system
macos-non-native-fullscreen = false
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden

# font
font-size = 20
font-family = SF Mono Square
alpha-blending = linear

# background
foreground = #cccccc
selection-background = #515151
selection-foreground = #cccccc
background = #2d2d2d
# background-opacity = 0.8  # use file to control
# background-blur-radius = 35
# background-opacity = 0.6

# cursor
shell-integration-features = no-cursor
cursor-style = block
cursor-color = #90EE90
cursor-style-blink = false
cursor-color = #cccccc
cursor-text = #2d2d2d
mouse-hide-while-typing = true

# pallete
theme = Tomorrow Night Eighties
palette = 0=#000000
palette = 1=#f2777a
palette = 2=#99cc99
palette = 3=#ffcc66
palette = 4=#6699cc
palette = 5=#cc99cc
palette = 6=#66cccc
palette = 7=#ffffff
palette = 8=#000000
palette = 9=#f2777a
palette = 10=#99cc99
palette = 11=#ffcc66
palette = 12=#6699cc
palette = 13=#cc99cc
palette = 14=#66cccc
palette = 15=#ffffff

# custom shaders
custom-shader = shaders/cursor_tail.glsl

###
# Keybinding
###

keybind = global:ctrl+enter=toggle_visibility
keybind = global:super+shift+`=toggle_quick_terminal

