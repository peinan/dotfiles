#!/bin/zsh
# Claude Code notification script
# Reads hook event from stdin and displays a rich notification

set -euo pipefail
# set -x  # for debug


# Read JSON from stdin
input=$(cat)

# Parse JSON fields using jq
hook_event=$(echo "$input" | jq -r '.hook_event_name // "Unknown"')
notification_type=$(echo "$input" | jq -r '.notification_type // ""')
message=$(echo "$input" | jq -r '.message // ""')
cwd=$(echo "$input" | jq -r '.cwd // ""')
transcript_path=$(echo "$input" | jq -r '.transcript_path // ""')
session_id=$(echo "$input" | jq -r '.session_id // ""')

# Shorten path: ~/p/r/myproject style
shorten_path() {
    local path="$1"

    # Replace HOME with ~
    path="${path/#$HOME/~}"

    # Split into parts
    local parts=("${(@s:/:)path}")
    local result=""
    local last_idx=$((${#parts[@]}))

    for i in {1..$last_idx}; do
        local part="${parts[$i]}"
        [[ -z "$part" ]] && continue

        if [[ $i -eq $last_idx ]]; then
            # Keep last part (project name) full
            result="${result}${part}"
        else
            # Shorten parent dirs to first char
            result="${result}${part[1]}/"
        fi
    done

    echo "$result"
}

project_path=$(shorten_path "$cwd")

# Function to get recent activity from transcript
get_recent_activity() {
    local transcript="$1"
    local activity=""

    if [[ -f "$transcript" ]]; then
        # Get last 20 lines and extract tool names and text content
        local tools=$(tail -20 "$transcript" 2>/dev/null | \
            jq -r 'select(.type == "assistant") | .message.content[]? | select(.type == "tool_use") | .name' 2>/dev/null | \
            sort | uniq -c | sort -rn | head -3 | \
            awk '{printf "%s(%d) ", $2, $1}')

        # Get the last assistant text message (if any)
        local last_text=$(tail -50 "$transcript" 2>/dev/null | \
            jq -r 'select(.type == "assistant") | .message.content[]? | select(.type == "text") | .text' 2>/dev/null | \
            tail -1 | head -c 100)

        # Get the most recent tool result summary
        local last_tool=$(tail -10 "$transcript" 2>/dev/null | \
            jq -r 'select(.toolUseResult) | "\(.toolUseResult | keys[0] // "tool")"' 2>/dev/null | \
            tail -1)

        if [[ -n "$tools" ]]; then
            activity="Tools: ${tools}"
        fi

        if [[ -n "$last_text" && ${#last_text} -gt 10 ]]; then
            # Truncate and clean the text
            last_text=$(echo "$last_text" | tr '\n' ' ' | head -c 80)
            activity="${activity:+$activity"$'\n'"}${last_text}..."
        fi
    fi

    echo "$activity"
}

# Determine notification title and subtitle based on event type
case "$hook_event" in
    "Notification")
        case "$notification_type" in
            "permission_prompt")
                title="⚠︎ Permission Required"
                subtitle="\[$project_path]"
                ;;
            "idle_prompt")
                title="⌚︎ Waiting for Input"
                subtitle="\[$project_path]"
                ;;
            "elicitation_dialog")
                title="⊙ Question"
                subtitle="\[$project_path]"
                ;;
            *)
                title="❇︎ Information"
                subtitle="\[$project_path]"
                ;;
        esac
        ;;
    "Stop")
        title="✔︎  Task Completed"
        subtitle="\[$project_path]"
        ;;
    *)
        title="❖  Claude Code"
        subtitle="\[$project_path]"
        ;;
esac

# Build notification body
body=""

# Add the hook message if available
if [[ -n "$message" ]]; then
    body="$message"
fi

# Add recent activity summary
if [[ -n "$transcript_path" ]]; then
    activity=$(get_recent_activity "$transcript_path")
    if [[ -n "$activity" ]]; then
        if [[ -n "$body" ]]; then
            body="${body}"$'\n'"---"$'\n'"${activity}"
        else
            body="$activity"
        fi
    fi
fi

echo "subtitle=$subtitle"

# Check if terminal-notifier is available
if command -v terminal-notifier &>/dev/null; then
    terminal-notifier \
        -title "$title" \
        -subtitle "$subtitle" \
        -message "$body" \
        -sound "Funk" \
        -group "claude-code-$session_id-$(date +%s)" \
        -activate "com.mitchellh.ghostty"
else
    # Fallback to osascript
    escape_for_applescript() {
        echo "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
    }

    title_escaped=$(escape_for_applescript "$title")
    subtitle_escaped=$(escape_for_applescript "$subtitle")
    body_escaped=$(escape_for_applescript "$body")

    osascript -e "display notification \"$body_escaped\" with title \"$title_escaped\" subtitle \"$subtitle_escaped\" sound name \"Funk\""
fi

# Log to notification log file
log_file="$HOME/.claude/notification-log.txt"
echo "$input" | jq -c --arg t "$title" --arg b "$body" '. + {displayed_title: $t, displayed_body: $b}' >> "$log_file"

exit 0
