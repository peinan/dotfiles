#!/bin/bash
# List files with metadata for fzf CTRL-T
#   Require: fd, gstat
#   Usage: fzf-file-list [Date|Size|Name]
#   Output format: "YYYY-MM-DD HH:MM │ SIZE │ FILEPATH"

sort_mode="${1:-Date}"

# fd --exec-batch: execute gstat once with all files as arguments
# gstat --printf: GNU stat format (timestamp, size, filename)
fd --type f --hidden --exclude .git --exec-batch gstat --printf="%.16y\t%s\t%n\n" 2>/dev/null | \
awk -F'\t' '{
    s=$2
    if(s>=1073741824) size=sprintf("%.1fG",s/1073741824)
    else if(s>=1048576) size=sprintf("%.1fM",s/1048576)
    else if(s>=1024) size=sprintf("%.1fK",s/1024)
    else size=sprintf("%dB",s)
    printf "%s\t%6s\t%s\n", $1, size, $3
}' | case "$sort_mode" in
    Date) sort -t$'\t' -k1 -r ;;
    Size) sort -t$'\t' -k2 -rh ;;
    Name) sort -t$'\t' -k3 ;;
    *) cat ;;
esac | sed 's/\t/ │ /g'
