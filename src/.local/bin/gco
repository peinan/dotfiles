#!/bin/zsh
#
# Git branch selector with fzf
# - Require: git, fzf
#

local branch

branch=$(git branch -a --color=always --format='%(refname:short)	%(if)%(HEAD)%(then)%(color:yellow bold)%(else)%(if:equals=refs/remotes)%(refname:rstrip=-2)%(then)%(color:red)%(else)%(color:cyan)%(end)%(end)%(align:50)%(refname:short)%(end) %(color:reset)%(color:dim)%(objectname:short)%(color:reset) %(contents:subject)' 2>/dev/null | \
    fzf --ansi \
        --with-nth=2.. \
        --delimiter='\t' \
        --height=~50% \
        --header='Branch selector' \
        --preview='git log --oneline --graph --color=always -20 {1}' \
        --preview-window=right:50%:wrap | \
    cut -f1)

if [[ -z "$branch" ]]; then
    exit 0
fi

# Extract branch name (remove remote prefix if present)
# remotes/origin/xxx -> xxx, origin/xxx -> xxx, xxx -> xxx
local checkout_name="$branch"
checkout_name="${checkout_name#remotes/}"
checkout_name="${checkout_name#origin/}"

git checkout "$checkout_name"
