#
# Git branch action tool with fzf
# - Require: git, fzf
#
# Usage:
#   gbr              # Branch select -> Action select
#   gbr -c           # Checkout mode (gco compatible)
#   gbr -d           # Delete mode
#   gbr -w           # Worktree add mode
#   gbr -W           # Worktree add -b mode (new branch)
#

# -----------------------------------------------------------------------------
# Helper functions
# -----------------------------------------------------------------------------

# Select a branch using fzf (multi-select enabled)
# Args: $1 - header text (optional), $2 - exclude current branch (optional, "true" to exclude)
# Returns: newline-separated list of selected branches

select_branch() {
    local header="${1:-Branch selector}"
    local exclude_current="$2"
    local format_str='%(refname:short)	%(HEAD)	%(if:equals=refs/remotes)%(refname:rstrip=-2)%(then)remote%(else)local%(end)	%(objectname:short)	%(contents:subject)'

    # Responsive layout based on terminal width
    local height="~60%"
    local preview_window="right,50%,wrap"
    if [[ $(tput cols) -lt 100 ]]; then
        height="~60%"
        preview_window="down,60%,wrap"
    fi

    local branch_list
    branch_list=$(git branch -a --format="$format_str" 2>/dev/null | awk -F'\t' '{
        branch = $1
        is_head = ($2 == "*")
        is_remote = ($3 == "remote")
        hash = $4
        subject = $5

        # Truncate to 40 characters with ellipsis
        if (length(branch) > 40) {
            display = substr(branch, 1, 39) "…"
        } else {
            display = branch
        }

        # Color selection
        if (is_head) color = "\033[1;33m"
        else if (is_remote) color = "\033[31m"
        else color = "\033[36m"

        printf "%s\t%s%-40s\033[0m \033[2m%s\033[0m %s\n", branch, color, display, hash, subject
    }')

    # Exclude current branch if requested
    if [[ "$exclude_current" == "true" ]]; then
        local current_branch
        current_branch=$(git branch --show-current 2>/dev/null)
        if [[ -n "$current_branch" ]]; then
            branch_list=$(echo "$branch_list" | grep -v "^${current_branch}	")
        fi
    fi

    echo "$branch_list" | \
        fzf --ansi \
            --multi \
            --with-nth=2.. \
            --delimiter='\t' \
            --height="$height" \
            --header="$header" \
            --preview='echo -e "\033[1;36mBranch:\033[0m {1}" && git log -1 --color=always --format="%C(bold cyan)Updated:%C(reset) %cr by %an" {1} 2>/dev/null && echo && git log --oneline --graph --color=always -20 {1}' \
            --preview-window="$preview_window" | \
        cut -f1
}

# Select a branch with action shortcuts (multi-select enabled)
# Returns: "branch1\nbranch2\n...|action" format
select_branch_with_action() {
    local format_str='%(refname:short)	%(HEAD)	%(if:equals=refs/remotes)%(refname:rstrip=-2)%(then)remote%(else)local%(end)	%(objectname:short)	%(contents:subject)'
    local header='<CR>: checkout | ^D: delete (TAB multi) | ^W: worktree add | ^T: worktree add -b'

    # Responsive layout based on terminal width
    local height="~60%"
    local preview_window="right,50%,wrap"
    if [[ $(tput cols) -lt 100 ]]; then
        height="~60%"
        preview_window="down,60%,wrap"
    fi

    git branch -a --format="$format_str" 2>/dev/null | awk -F'\t' '{
        branch = $1
        is_head = ($2 == "*")
        is_remote = ($3 == "remote")
        hash = $4
        subject = $5

        # Truncate to 40 characters with ellipsis
        if (length(branch) > 40) {
            display = substr(branch, 1, 39) "…"
        } else {
            display = branch
        }

        # Color selection
        if (is_head) color = "\033[1;33m"
        else if (is_remote) color = "\033[31m"
        else color = "\033[36m"

        printf "%s\t%s%-40s\033[0m \033[2m%s\033[0m %s\n", branch, color, display, hash, subject
    }' | \
        fzf --ansi \
            --multi \
            --with-nth=2.. \
            --delimiter='\t' \
            --height="$height" \
            --header="$header" \
            --preview='echo -e "\033[1;36mBranch:\033[0m {1}" && git log -1 --color=always --format="%C(bold cyan)Updated:%C(reset) %cr by %an" {1} 2>/dev/null && echo && git log --oneline --graph --color=always -20 {1}' \
            --preview-window="$preview_window" \
            --expect=ctrl-d,ctrl-w,ctrl-t | \
        {
            local key
            read -r key
            local branches=()
            while IFS= read -r line; do
                [[ -n "$line" ]] && branches+=("$(echo "$line" | cut -f1)")
            done
            # Join branches with newline, append |action
            local IFS=$'\n'
            echo "${branches[*]}|${key}"
        }
}

# Extract clean branch name (remove remote prefix)
# remotes/origin/xxx -> xxx, origin/xxx -> xxx, xxx -> xxx
extract_branch_name() {
    local branch="$1"
    branch="${branch#remotes/}"
    branch="${branch#origin/}"
    echo "$branch"
}

# -----------------------------------------------------------------------------
# Action functions
# -----------------------------------------------------------------------------

action_checkout() {
    local branch="$1"
    if [[ -z "$branch" ]]; then
        return 0
    fi

    local checkout_name
    checkout_name=$(extract_branch_name "$branch")
    git checkout "$checkout_name"
}

# Delete branches (supports multiple branches)
# Args: $1 - newline-separated list of branches
action_delete() {
    local input="$1"
    if [[ -z "$input" ]]; then
        return 0
    fi

    # Parse newline-separated input into array
    local branches=("${(@f)input}")

    # Filter out empty entries
    branches=("${(@)branches:#}")
    if [[ ${#branches[@]} -eq 0 ]]; then
        return 0
    fi

    local current_branch
    current_branch=$(git branch --show-current 2>/dev/null)

    # Pre-validation: collect valid branches, separate local and remote
    local local_branches=()
    local remote_branches=()
    for branch in "${branches[@]}"; do
        local branch_name
        branch_name=$(extract_branch_name "$branch")

        # Check if it's current branch
        if [[ "$branch_name" == "$current_branch" ]]; then
            echo "Error: Cannot delete current branch '$branch_name'" >&2
            continue
        fi

        # Separate local and remote branches
        if [[ "$branch" == remotes/* || "$branch" == origin/* ]]; then
            remote_branches+=("$branch_name")
        else
            local_branches+=("$branch_name")
        fi
    done

    if [[ ${#local_branches[@]} -eq 0 && ${#remote_branches[@]} -eq 0 ]]; then
        echo "No valid branches to delete."
        return 1
    fi

    # Confirmation
    local total=$((${#local_branches[@]} + ${#remote_branches[@]}))
    if [[ $total -eq 1 ]]; then
        if [[ ${#local_branches[@]} -eq 1 ]]; then
            echo -n "Delete local branch '${local_branches[1]}'? [y/N]: "
        else
            echo -n "Delete remote branch '${remote_branches[1]}'? [y/N]: "
        fi
    else
        echo "Delete $total branch(es):"
        for b in "${local_branches[@]}"; do
            echo "  - $b (local)"
        done
        for b in "${remote_branches[@]}"; do
            echo "  - $b (remote)"
        done
        echo -n "Confirm? [y/N]: "
    fi

    read -r confirm
    if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
        echo "Cancelled."
        return 0
    fi

    # Delete local branches
    local failed=0
    for branch_name in "${local_branches[@]}"; do
        if git branch -d "$branch_name" 2>/dev/null || git branch -D "$branch_name" 2>/dev/null; then
            echo "Deleted local branch '$branch_name'"
        else
            echo "Error: Failed to delete local branch '$branch_name'" >&2
            ((failed++))
        fi
    done

    # Delete remote branches
    for branch_name in "${remote_branches[@]}"; do
        if git push origin --delete "$branch_name" 2>/dev/null; then
            echo "Deleted remote branch '$branch_name'"
        else
            echo "Error: Failed to delete remote branch '$branch_name'" >&2
            ((failed++))
        fi
    done

    [[ $failed -eq 0 ]]
}

action_worktree_add() {
    local branch="$1"
    if [[ -z "$branch" ]]; then
        return 0
    fi

    local branch_name
    branch_name=$(extract_branch_name "$branch")

    # Prompt for worktree path
    local repo_name
    repo_name=$(basename "$PWD")
    local default_path="../${repo_name}=${branch_name//\//-}"
    echo -n "Worktree path [$default_path]: "
    read -r worktree_path
    worktree_path="${worktree_path:-$default_path}"

    git worktree add "$worktree_path" "$branch_name"
    echo "Worktree created at: $worktree_path"
    cd "$worktree_path"
}

action_worktree_add_b() {
    local base_branch="$1"

    # Prompt for new branch name
    echo -n "New branch name: "
    read -r new_branch
    if [[ -z "$new_branch" ]]; then
        echo "Cancelled."
        return 0
    fi

    # Prompt for worktree path
    local repo_name
    repo_name=$(basename "$PWD")
    local default_path="../${repo_name}=${new_branch//\//-}"
    echo -n "Worktree path [$default_path]: "
    read -r worktree_path
    worktree_path="${worktree_path:-$default_path}"

    if [[ -n "$base_branch" ]]; then
        local base_name
        base_name=$(extract_branch_name "$base_branch")
        git worktree add -b "$new_branch" "$worktree_path" "$base_name"
    else
        git worktree add -b "$new_branch" "$worktree_path"
    fi
    echo "Worktree created at: $worktree_path (branch: $new_branch)"
    cd "$worktree_path"
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

local mode=""

# Parse arguments
while getopts "cdwW" opt; do
    case $opt in
        c) mode="checkout" ;;
        d) mode="delete" ;;
        w) mode="worktree" ;;
        W) mode="worktree-b" ;;
        *) echo "Usage: gbr [-c|-d|-w|-W]" >&2; return 1 ;;
    esac
done

case "$mode" in
    checkout)
        local branch
        branch=$(select_branch "Checkout branch")
        action_checkout "$branch"
        ;;
    delete)
        local branches
        branches=$(select_branch "Delete branch(es) - TAB to multi-select" "true")
        action_delete "$branches"
        ;;
    worktree)
        local branch
        branch=$(select_branch "Worktree add (select branch)")
        action_worktree_add "$branch"
        ;;
    worktree-b)
        local branch
        branch=$(select_branch "Worktree add -b (select base branch, or ESC for current)")
        action_worktree_add_b "$branch"
        ;;
    *)
        # Default: select branch with action shortcuts
        local result branches action
        result=$(select_branch_with_action)
        branches="${result%|*}"
        action="${result#*|}"

        if [[ -z "$branches" ]]; then
            return 0
        fi

        # For checkout/worktree, use only the first selected branch
        local first_branch
        first_branch="${branches%%$'\n'*}"

        case "$action" in
            ctrl-d)
                action_delete "$branches"
                ;;
            ctrl-w)
                action_worktree_add "$first_branch"
                ;;
            ctrl-t)
                action_worktree_add_b "$first_branch"
                ;;
            *)
                # Default: checkout (Enter key)
                action_checkout "$first_branch"
                ;;
        esac
        ;;
esac
